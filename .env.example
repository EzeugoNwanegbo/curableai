# OpenAI primary provider
OPENAI_API_KEY="replace-with-openai-key"
OPENAI_MODEL="gpt-4o"

# DeepSeek fallback provider
DEEPSEEK_API_KEY="replace-with-deepseek-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Supabase client credentials (safe to expose; protected by database RLS)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# PostHog browser analytics. Page categories only. No replay, click capture, or health text.
VITE_POSTHOG_KEY="your-posthog-project-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
